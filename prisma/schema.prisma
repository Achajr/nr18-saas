generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auth_users {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model master_admins {
  id         String   @id
  full_name  String
  email      String?  @unique
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model consultorias {
  id                 String   @id @default(uuid())
  name               String
  cnpj               String?
  email              String?
  phone              String?
  responsavel_nome   String?
  responsavel_email  String?
  plan               String   @default("pro")
  max_avaliadores    Int      @default(5)
  max_empresas       Int      @default(30)
  max_obras          Int      @default(999)
  active             Boolean  @default(true)
  created_by         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model avaliadores {
  id              String   @id
  consultoria_id  String?
  full_name       String
  email           String?  @unique
  role            String   @default("avaliador")
  tipo_registro   String?
  registro_mte    String?
  crea            String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model empresas_clientes {
  id                    String   @id @default(uuid())
  consultoria_id         String
  name                  String
  cnpj                  String?
  email                 String?
  phone                 String?
  endereco              String?
  cidade                String?
  uf                    String?
  cep                   String?
  cnae                  String?
  grau_risco            String?
  responsavel_nome      String?
  responsavel_cargo     String?
  responsavel_email     String?
  avaliador_responsavel String?
  active                Boolean  @default(true)
  created_by            String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model obras {
  id                 String   @id @default(uuid())
  consultoria_id      String
  empresa_cliente_id  String?
  avaliador_id        String?
  name               String
  etapa              String?
  status             String   @default("ativa")
  empresa_nome        String?
  empresa_cnpj        String?
  num_funcionarios    Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model obra_empreiteiras {
  id               String   @id @default(uuid())
  obra_id           String
  consultoria_id    String?
  name             String
  cnpj             String?
  num_funcionarios Int      @default(0)
  ativa            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model vistorias {
  id                    String   @id @default(uuid())
  obra_id                String
  consultoria_id         String
  avaliador_id           String
  numero                String
  data_vistoria          String
  clima                 String?
  etapa_obra             String?
  observacoes_gerais     String?
  status                String   @default("em_andamento")
  total_itens            Int      @default(0)
  total_conformes        Int      @default(0)
  total_nao_conformes    Int      @default(0)
  total_na               Int      @default(0)
  indice_conformidade    Float    @default(0)
  classificacao          String?
  parecer_ia             String?
  parecer_editado        String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}

model vistoria_itens {
  id                       String   @id @default(uuid())
  vistoria_id               String
  item_id                  String
  bloco_id                 String
  bloco_titulo             String?
  item_texto               String?
  item_ref                 String?
  item_nivel               String?
  item_perigo              String?
  item_multa               String?
  item_nr_texto            String?
  item_etapa               String?
  item_tipo_verificacao    String?
  item_evidencias          Json     @default("[]")
  item_aplicabilidade      String?
  item_criterio            String?
  status                   String
  observacao               String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model vistoria_item_empresas {
  id              String   @id @default(uuid())
  vistoria_id      String
  item_id         String
  empresa_tipo    String
  empreiteira_id  String?
  created_at      DateTime @default(now())
}

model vistoria_fotos {
  id                String   @id @default(uuid())
  vistoria_id        String
  organization_id    String?
  item_id            String?
  vistoria_item_id   String?
  storage_path       String
  filename           String?
  mime_type          String?
  tipo              String   @default("nc")
  created_at         DateTime @default(now())
}
